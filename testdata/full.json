{
  "account_id": "account-123",
  "repo": "worldcoin/tfh-website",
  "repo_connection_uuid": "repo-connection-123",
  "provider_type": "github",
  "provider_account_id": "42",
  "provider_account_name": "worldcoin",
  "repo_id": "100",
  "repo_name": "tfh-website",
  "workers": {
    "tfh-website": {
      "build_token_name": "tfh-build-token",
      "production_branch": "prod",
      "root_directory": "apps/tfh-website",
      "path_includes": [
        "apps/tfh-website/**",
        "scripts/**"
      ],
      "path_excludes": [
        "docs/**"
      ],
      "build_caching_enabled": true,
      "build_command": "npm run build:cf",
      "deploy_command": "npm run deploy:cf:prod",
      "preview": {
        "enabled": true,
        "command": "npm run deploy:cf:preview",
        "branch_includes": [
          "*"
        ],
        "branch_excludes": [
          "prod",
          "promote-main-to-prod"
        ],
        "build_vars": {
          "NEXT_PUBLIC_APP_ENV": "preview"
        },
        "build_secrets": [
          "PREVIEW_ONLY_SECRET"
        ]
      },
      "build_vars": {
        "NODE_VERSION": "22",
        "NEXT_PUBLIC_APP_ENV": "production"
      },
      "build_secrets": [
        "NEXT_SERVER_HUBSPOT_API_TOKEN"
      ],
      "runtime_secrets": [
        "NEXT_SERVER_HUBSPOT_API_TOKEN"
      ]
    }
  }
}
